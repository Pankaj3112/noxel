{
  "name": "@noxel/cli",
  "version": "0.1.0",
  "description": "Deploy open-source apps in minutes",
  "license": "MIT",
  "type": "module",
  "bin": {
    "noxel": "./dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/noxel-sh/noxel"
  },
  "keywords": [
    "noxel",
    "deploy",
    "self-hosted",
    "digitalocean",
    "cli"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc && cp -r src/templates dist/",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clack/prompts": "^0.9.0",
    "commander": "^13.0.0",
    "js-yaml": "^4.1.0",
    "open": "^11.0.0",
    "picocolors": "^1.1.0",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/ssh2": "^1.15.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0"
  }
}
