# DigitalOcean OAuth App (required for 'noxel connect digitalocean')
# Get these from: https://cloud.digitalocean.com/account/api/applications
NOXEL_DO_CLIENT_ID=your_client_id_here
NOXEL_DO_CLIENT_SECRET=your_client_secret_here

CLOUDFLARE_API_TOKEN=your_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
DOMAIN=yourdomain.com
